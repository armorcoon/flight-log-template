# ค่าเหล่านี้ตั้งบน Vercel → Settings → Environment Variables
# (ถ้าจะรันในเครื่องด้วย npm run dev ให้คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่า)

# รหัสผ่านรวมที่แจกให้เจ้าหน้าที่ในหน่วย — ควรเป็นวลียาว ไม่ใช่คำสั้น ๆ
DASHBOARD_PASSWORD=

# กุญแจสำหรับเซ็นคุกกี้เซสชัน — สุ่มยาว ๆ และห้ามเปิดเผย
# สร้างได้จาก https://generate-secret.vercel.app/32
# หรือ:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ID ของไฟล์ flight_data.json บน Google Drive — ได้จาก Log ตอนรัน setup() ใน Apps Script
DRIVE_FILE_ID=
